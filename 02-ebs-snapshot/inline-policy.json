{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CreateInspectAndTagSnapshots",
      "Effect": "Allow",
      "Action": [
        "ec2:CreateSnapshot",
        "ec2:DescribeSnapshots",
        "ec2:CreateTags"
      ],
      "Resource": "*"
    },
    {
      "Sid": "DeleteOnlyTaggedLabSnapshots",
      "Effect": "Allow",
      "Action": "ec2:DeleteSnapshot",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "ec2:ResourceTag/CreatedBy": "Lambda-Backup",
          "ec2:ResourceTag/SourceVolumeId": "REPLACE_WITH_VOLUME_ID"
        }
      }
    },
    {
      "Sid": "WriteLambdaLogs",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogGroup",
        "logs:CreateLogStream",
        "logs:PutLogEvents"
      ],
      "Resource": "*"
    }
  ]
}
