{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListBucket",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::REPLACE_BUCKET_NAME",
      "Condition": {"StringLike": {"s3:prefix": ["REPLACE_PREFIX", "REPLACE_PREFIX/*"]}}
    },
    {
      "Sid": "DeleteObjects",
      "Effect": "Allow",
      "Action": "s3:DeleteObject",
      "Resource": "arn:aws:s3:::REPLACE_BUCKET_NAME/REPLACE_PREFIX/*"
    },
    {
      "Sid": "LambdaLogs",
      "Effect": "Allow",
      "Action": ["logs:CreateLogGroup", "logs:CreateLogStream", "logs:PutLogEvents"],
      "Resource": "arn:aws:logs:*:*:*"
    }
  ]
}
