# Copy this file to lab.env and edit the values.
# Never commit lab.env because it may contain local settings or profile names.

export AWS_REGION=us-east-1
export AWS_DEFAULT_REGION="$AWS_REGION"

# Filled automatically when AWS credentials are available. This is not a secret.
if command -v aws >/dev/null 2>&1; then
  export ACCOUNT_ID="${ACCOUNT_ID:-$(aws sts get-caller-identity --query Account --output text 2>/dev/null || true)}"
fi

# Access-key method only:
# Uncomment after running: aws configure --profile lab
# export AWS_PROFILE=lab

export LAB_ROOT="$HOME/aws-lambda-automation-assignments"
export LAMBDA_RUNTIME=python3.12
export EC2_INSTANCE_TYPE=t3.micro
export DEFAULT_RETENTION_DAYS=30
export TEST_PREFIX=test/
